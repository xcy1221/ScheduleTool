# 复制为 .env 后填写；真实配置不要提交 Git。
APP_VERSION=0.2.0
DB_URL=jdbc:mysql://mysql:3306/scheduletool?sslMode=REQUIRED&connectionTimeZone=Asia/Shanghai&forceConnectionTimeZoneToSession=true
DB_USER=scheduletool_prod
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
APP_USERNAME=admin
# --hash-password 从 stdin 生成；单引号保留 BCrypt 中的 $。
APP_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
# 外部网络须已存在；地址须位于实际子网且未被占用。
PROXY_NETWORK=caddy-proxy
MYSQL_NETWORK=mysql_default
MYSQL_IPV4=172.30.0.10
# 仅预构建 JAR / MCP 部署使用；正式发布建议固定已验证的 digest。
JAVA_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
# 以下仅 deploy/mcp/compose.yml 使用。
TUNNEL_VERSION=0.0.16
TUNNEL_PROXY_IPV4=172.31.0.10
EGRESS_NETWORK=mihomo-proxy
TUNNEL_EGRESS_IPV4=172.29.0.10
